    const steps = Math.max(Math.abs(rowDelta), Math.abs(columnDelta))
    const rowStep = Math.sign(rowDelta)
    const columnStep = Math.sign(columnDelta)
    const path = []

    for (let step = 0; step <= steps; step += 1) {
