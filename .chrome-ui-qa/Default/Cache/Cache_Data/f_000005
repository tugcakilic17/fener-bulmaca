      progressX + progressWidth + 10,
      progressY + progressHeight / 2,
      `${this.foundWords.size}/${this.puzzle.words.length} bulundu`,
      {
        fontSize: `${compact ? 13 : 17}px`,
        fontStyle: 'bold',
        color: '#5a2e1a',
