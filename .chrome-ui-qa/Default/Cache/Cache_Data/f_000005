    const toastHeight = 56
    this.toast = this.scene.add.container(x, y).setDepth(30).setAlpha(0)
    const graphics = this.scene.add.graphics()

    graphics.fillStyle(0x06162f, 0.42)
    graphics.fillRoundedRect(-width / 2 + 4, -toastHeight / 2 + 6, width, toastHeight, 22)
    graphics.fillStyle(0xfff3c9, 1)
