        this.cells.push(cell)

        this.addText(
          cellX + cellSize / 2,
          cellY + cellSize / 2,
          letter,
          {
            fontSize: `${Phaser.Math.Clamp(cellSize * 0.43, 20, 46)}px`,
            fontStyle: 'bold',
            color: '#102b55',
