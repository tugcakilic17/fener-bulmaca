    const { x, y, width, height } = panel
    const padding = compact ? 14 : 20

    graphics.fillStyle(0x07162b, 0.48)
    graphics.fillRoundedRect(x + 6, y + 8, width, height, 20)
    graphics.fillStyle(0x74401e, 1)
    graphics.fillRoundedRect(x, y, width, height, 20)
    graphics.lineStyle(4, 0xbb7136, 1)
    graphics.strokeRoundedRect(x, y, width, height, 20)
    graphics.fillStyle(0xffefd1, 1)
    graphics.fillRoundedRect(
      x + padding * 0.55,
      y + padding * 0.65,
      width - padding * 1.1,
      height - padding * 1.3,
