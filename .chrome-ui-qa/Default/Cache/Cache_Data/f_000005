    const availableHeight = y + height - padding - listTop
    const rowGap = compact ? 5 : 8
    const rowHeight = Math.min(
      compact ? 45 : 62,
      (availableHeight - rowGap * (this.puzzle.words.length - 1)) /
        this.puzzle.words.length,
    )

    this.puzzle.words.forEach((word, index) => {
      const rowY = listTop + index * (rowHeight + rowGap)
      const isFound = this.foundWords.has(word)

      graphics.fillStyle(isFound ? 0xe2f5c9 : 0xf6dcba, 0.78)
      graphics.fillRoundedRect(
        x + padding,
        rowY,
        width - padding * 2,
        rowHeight,
        12,
      )

      const iconX = x + padding + (compact ? 18 : 24)
      const iconY = rowY + rowHeight / 2
      if (isFound) {
        graphics.fillStyle(0x38b84a, 1)
