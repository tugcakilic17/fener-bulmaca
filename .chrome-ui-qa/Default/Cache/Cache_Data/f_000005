    const progressWidth = width * (compact ? 0.53 : 0.56)
    const progressHeight = compact ? 13 : 18
    const progressX = x + padding
    const ratio = this.foundWords.size / this.puzzle.words.length

    graphics.fillStyle(0xd8c4a8, 0.75)
    graphics.fillRoundedRect(progressX, progressY, progressWidth, progressHeight, 7)
