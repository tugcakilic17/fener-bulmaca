      this.addText(
        iconX + (compact ? 24 : 34),
        iconY,
        word.charAt(0) + word.slice(1).toLocaleLowerCase('tr-TR'),
        {
          fontSize: `${compact ? 16 : 22}px`,
          fontStyle: 'bold',
          color: isFound ? '#2e7536' : '#17325b',
        },
        0,
        0.5,
      )
    })
  }

  startSelection(row, column) {
